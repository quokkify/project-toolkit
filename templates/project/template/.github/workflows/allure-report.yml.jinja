name: Allure report

on:
  workflow_run:
    workflows: [Validate]
    types: [completed]

permissions: {}

concurrency:
  group: allure-report-{% raw %}${{ github.event.workflow_run.head_repository.id }}-${{ github.event.workflow_run.head_branch }}{% endraw %}
  cancel-in-progress: true

jobs:
  resolve:
    name: Resolve trusted source run
    if: {% raw %}${{ github.event.workflow_run.event == 'pull_request' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      actions: read
      contents: read
      pull-requests: read
    outputs:
      ready: {% raw %}${{ steps.resolve.outputs.ready }}{% endraw %}
      pr-number: {% raw %}${{ steps.resolve.outputs.pr-number }}{% endraw %}
      fork-pr: {% raw %}${{ steps.resolve.outputs.fork-pr }}{% endraw %}
    steps:
      - name: Resolve PR and validate source artifacts
        id: resolve
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v8.0.0
        with:
          script: |
            const run = context.payload.workflow_run;
            const expectedArtifacts = [
            {% for component in components %}  "allure-results-{{ component.type }}-{{ loop.index }}",
            {% endfor %}];
            const skip = (message) => {
              core.warning(message);
              core.setOutput("ready", "false");
            };
            if (run.path !== ".github/workflows/validate.yml") {
              skip(`Ignore unexpected source workflow path: ${run.path}`);
              return;
            }
            const headRepository = run.head_repository?.full_name;
            if (!headRepository || !run.head_sha) {
              skip("Source run has no live head repository or SHA.");
              return;
            }
            const pulls = await github.paginate(github.rest.pulls.list, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              state: "open",
              per_page: 100,
            });
            const matches = pulls.filter((pull) =>
              pull.base?.repo?.full_name === `${context.repo.owner}/${context.repo.repo}` &&
              pull.head?.repo?.full_name === headRepository &&
              pull.head?.sha === run.head_sha
            );
            if (matches.length !== 1) {
              skip(`Expected exactly one current open PR for source SHA; found ${matches.length}.`);
              return;
            }
            const sourceRuns = await github.paginate(github.rest.actions.listWorkflowRuns, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              workflow_id: run.workflow_id,
              event: "pull_request",
              head_sha: run.head_sha,
              per_page: 100,
            });
            const newestRunId = Math.max(...sourceRuns.map((candidate) => Number(candidate.id)));
            if (!Number.isSafeInteger(newestRunId) || Number(run.id) !== newestRunId) {
              skip("A newer Validate run exists for this PR head; stale report suppressed.");
              return;
            }
            const artifacts = await github.paginate(github.rest.actions.listWorkflowRunArtifacts, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              run_id: run.id,
              per_page: 100,
            });
            const allureArtifacts = artifacts.filter((artifact) =>
              artifact.name.startsWith("allure-results-")
            );
            const actualNames = allureArtifacts.map((artifact) => artifact.name).sort();
            const expectedNames = [...expectedArtifacts].sort();
            if (JSON.stringify(actualNames) !== JSON.stringify(expectedNames)) {
              core.setFailed(`Allure artifact contract mismatch. Expected ${expectedNames.join(", ")}; received ${actualNames.join(", ") || "none"}.`);
              return;
            }
            if (allureArtifacts.some((artifact) => artifact.expired)) {
              core.setFailed("One or more required Allure artifacts have expired.");
              return;
            }
            const compressedBytes = allureArtifacts.reduce(
              (total, artifact) => total + Number(artifact.size_in_bytes || 0),
              0,
            );
            if (compressedBytes > 262144000) {
              core.setFailed(`Allure artifacts exceed the 250 MiB compressed limit: ${compressedBytes} bytes.`);
              return;
            }
            const pull = matches[0];
            core.setOutput("ready", "true");
            core.setOutput("pr-number", String(pull.number));
            const pagesUnsafe = pull.head.repo.full_name !== pull.base.repo.full_name ||
              pull.user?.login === "dependabot[bot]";
            core.setOutput("fork-pr", String(pagesUnsafe));

  generate:
    name: Generate unprivileged report
    needs: resolve
    if: {% raw %}${{ needs.resolve.outputs.ready == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      actions: read
      contents: read
    steps:
      - name: Check out trusted report configuration
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {% raw %}${{ github.sha }}{% endraw %}
          persist-credentials: false
{% for component in components %}
      - name: Download {{ component.type }} {{ loop.index }} Allure results
        uses: actions/download-artifact@fa0a91b85d4f404e444e00e005971372dc801d16 # v7.0.0
        with:
          name: allure-results-{{ component.type }}-{{ loop.index }}
          path: {% raw %}${{ runner.temp }}{% endraw %}/allure-inputs/{{ component.type }}-{{ loop.index }}
          run-id: {% raw %}${{ github.event.workflow_run.id }}{% endraw %}
          github-token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
{% endfor %}
      - name: Validate and merge Allure results
        shell: bash
        env:
          INPUT_ROOT: {% raw %}${{ runner.temp }}{% endraw %}/allure-inputs
          OUTPUT_ROOT: {% raw %}${{ github.workspace }}{% endraw %}/.allure-input/results
        run: |
          python - <<'PY'
          import os
          import shutil
          import stat
          from pathlib import Path

          source_root = Path(os.environ["INPUT_ROOT"])
          output_root = Path(os.environ["OUTPUT_ROOT"])
          shutil.rmtree(output_root.parent, ignore_errors=True)
          output_root.mkdir(parents=True)
          seen: set[Path] = set()
          total_files = 0
          total_bytes = 0
          for source in sorted(source_root.iterdir()):
              if source.is_symlink() or not source.is_dir():
                  raise SystemExit(f"unsafe Allure artifact root: {source.name}")
              for path in sorted(source.rglob("*")):
                  metadata = path.lstat()
                  relative = path.relative_to(source)
                  if stat.S_ISLNK(metadata.st_mode):
                      raise SystemExit(f"symlink rejected in Allure artifact: {source.name}/{relative}")
                  if stat.S_ISDIR(metadata.st_mode):
                      continue
                  if not stat.S_ISREG(metadata.st_mode):
                      raise SystemExit(f"non-regular Allure artifact entry rejected: {source.name}/{relative}")
                  if relative in seen:
                      raise SystemExit(f"duplicate Allure artifact path: {relative}")
                  seen.add(relative)
                  total_files += 1
                  total_bytes += metadata.st_size
                  if total_files > 20000 or total_bytes > 1073741824:
                      raise SystemExit("Allure artifacts exceed extracted file-count or 1 GiB size limits")
                  destination = output_root / relative
                  destination.parent.mkdir(parents=True, exist_ok=True)
                  shutil.copyfile(path, destination)
          if not seen:
              raise SystemExit("required Allure artifacts contained no regular files")
          PY
      - name: Build Allure report without write privileges
        uses: quokkify/project-toolkit/actions/allure-report@{{ toolkit_version }}
        with:
          github-token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          results-directory: .allure-input/results
          report-directory: allure-report
          config-file: .github/allure/allurerc.mjs
          source-run-id: {% raw %}${{ github.event.workflow_run.id }}{% endraw %}
      - name: Upload generated Allure HTML
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: allure-report-{% raw %}${{ github.run_id }}{% endraw %}
          path: allure-report
          if-no-files-found: error
          retention-days: 14

  comment:
    name: Publish trusted PR comment
    needs: [resolve, generate]
    if: {% raw %}${{ needs.resolve.outputs.ready == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      actions: read
      pull-requests: write
    steps:
      - name: Revalidate source freshness and update comment
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v8.0.0
        with:
          script: |
            const run = context.payload.workflow_run;
            const prNumber = Number({% raw %}${{ needs.resolve.outputs.pr-number }}{% endraw %});
            const { data: pull } = await github.rest.pulls.get({
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: prNumber,
            });
            if (pull.state !== "open" || pull.head?.sha !== run.head_sha ||
                pull.head?.repo?.full_name !== run.head_repository?.full_name) {
              core.warning("PR head changed; stale Allure comment suppressed.");
              return;
            }
            const sourceRuns = await github.paginate(github.rest.actions.listWorkflowRuns, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              workflow_id: run.workflow_id,
              event: "pull_request",
              head_sha: run.head_sha,
              per_page: 100,
            });
            if (Number(run.id) !== Math.max(...sourceRuns.map((candidate) => Number(candidate.id)))) {
              core.warning("A newer Validate run exists; stale Allure comment suppressed.");
              return;
            }
            const marker = "<!-- project-toolkit-allure-report -->";
            const reportRun = `${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}`;
            const sourceRun = `${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${run.id}`;
            let body = `${marker}\n## Allure test report\n\nThe report was generated in a read-only job from validated artifacts for \`${run.head_sha.slice(0, 12)}\`.\n\n- [Download the Allure HTML artifact](${reportRun})\n- [Open the source validation run](${sourceRun})`;
{% if allure_publish_pages %}            const pagesBaseUrl = {{ allure_pages_url | tojson }};
            if (pull.head.repo.full_name === pull.base.repo.full_name &&
                pull.user?.login !== "dependabot[bot]") {
              body += `\n- [Open the published report](${pagesBaseUrl}/allure/pr-${prNumber}/)`;
            }
{% endif %}            const comments = await github.paginate(github.rest.issues.listComments, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: prNumber,
              per_page: 100,
            });
            const existing = comments.find((comment) =>
              comment.user?.login === "github-actions[bot]" && (comment.body || "").includes(marker)
            );
            if (existing) {
              await github.rest.issues.updateComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                comment_id: existing.id,
                body,
              });
            } else {
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: prNumber,
                body,
              });
            }
{% if allure_publish_pages %}
  pages:
    name: Publish trusted Pages report
    needs: [resolve, generate]
    if: >-
      {% raw %}${{
        needs.resolve.outputs.ready == 'true' &&
        needs.resolve.outputs.fork-pr == 'false'
      }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      actions: read
      contents: write
      pull-requests: read
    steps:
      - name: Revalidate source freshness
        id: freshness
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v8.0.0
        with:
          script: |
            const run = context.payload.workflow_run;
            const prNumber = Number({% raw %}${{ needs.resolve.outputs.pr-number }}{% endraw %});
            const { data: pull } = await github.rest.pulls.get({
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: prNumber,
            });
            const sameHead = pull.state === "open" && pull.head?.sha === run.head_sha &&
              pull.head?.repo?.full_name === run.head_repository?.full_name;
            const sourceRuns = await github.paginate(github.rest.actions.listWorkflowRuns, {
              owner: context.repo.owner,
              repo: context.repo.repo,
              workflow_id: run.workflow_id,
              event: "pull_request",
              head_sha: run.head_sha,
              per_page: 100,
            });
            const latest = Number(run.id) === Math.max(
              ...sourceRuns.map((candidate) => Number(candidate.id))
            );
            core.setOutput("fresh", String(sameHead && latest));
      - name: Download generated report
        if: {% raw %}${{ steps.freshness.outputs.fresh == 'true' }}{% endraw %}
        uses: actions/download-artifact@fa0a91b85d4f404e444e00e005971372dc801d16 # v7.0.0
        with:
          name: allure-report-{% raw %}${{ github.run_id }}{% endraw %}
          path: {% raw %}${{ runner.temp }}{% endraw %}/allure-report
      - name: Validate Pages payload
        if: {% raw %}${{ steps.freshness.outputs.fresh == 'true' }}{% endraw %}
        shell: bash
        env:
          SOURCE: {% raw %}${{ runner.temp }}{% endraw %}/allure-report
          DESTINATION: {% raw %}${{ github.workspace }}{% endraw %}/allure-report
        run: |
          python - <<'PY'
          import os
          import shutil
          import stat
          from pathlib import Path

          source = Path(os.environ["SOURCE"])
          destination_root = Path(os.environ["DESTINATION"])
          shutil.rmtree(destination_root, ignore_errors=True)
          destination_root.mkdir(parents=True)
          total_files = 0
          total_bytes = 0
          for path in sorted(source.rglob("*")):
              metadata = path.lstat()
              relative = path.relative_to(source)
              if stat.S_ISLNK(metadata.st_mode):
                  raise SystemExit(f"symlink rejected in Pages payload: {relative}")
              if stat.S_ISDIR(metadata.st_mode):
                  continue
              if not stat.S_ISREG(metadata.st_mode):
                  raise SystemExit(f"non-regular Pages payload entry rejected: {relative}")
              total_files += 1
              total_bytes += metadata.st_size
              if total_files > 30000 or total_bytes > 1073741824:
                  raise SystemExit("Pages payload exceeds file-count or 1 GiB size limits")
              destination = destination_root / relative
              destination.parent.mkdir(parents=True, exist_ok=True)
              shutil.copyfile(path, destination)
          if total_files == 0:
              raise SystemExit("generated Pages payload is empty")
          PY
      - name: Publish Allure HTML to GitHub Pages
        if: {% raw %}${{ steps.freshness.outputs.fresh == 'true' }}{% endraw %}
        uses: quokkify/project-toolkit/actions/deploy-gh-pages-subdir@{{ toolkit_version }}
        with:
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          publish-dir: allure-report
          destination-dir: allure/pr-{% raw %}${{ needs.resolve.outputs.pr-number }}{% endraw %}
{% endif %}
