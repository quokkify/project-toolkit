name: Allure report

on:
  workflow_run:
    workflows: [Validate]
    types: [completed]

permissions:
  actions: read
  contents: {% if allure_publish_pages %}write{% else %}read{% endif %}
  pull-requests: write

concurrency:
  group: allure-report-{% raw %}${{ github.event.workflow_run.id }}{% endraw %}
  cancel-in-progress: false

jobs:
  report:
    name: Build Allure report
    if: >-
      {% raw %}${{
        github.event.workflow_run.event == 'pull_request' &&
        github.event.workflow_run.pull_requests[0] != null
      }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Check out trusted report configuration
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
          persist-credentials: false
      - name: Download Allure result artifacts
        uses: actions/download-artifact@fa0a91b85d4f404e444e00e005971372dc801d16 # v7.0.0
        with:
          pattern: allure-results-*
          path: artifacts/allure-results
          merge-multiple: true
          run-id: {% raw %}${{ github.event.workflow_run.id }}{% endraw %}
          github-token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Detect downloaded Allure results
        id: results
        shell: bash
        run: |
          if find artifacts/allure-results -type f -print -quit 2>/dev/null | grep -q .; then
            echo "found=true" >> "$GITHUB_OUTPUT"
          else
            echo "found=false" >> "$GITHUB_OUTPUT"
            echo "No Allure result files were produced by the source workflow." >> "$GITHUB_STEP_SUMMARY"
          fi
      - name: Build and comment Allure report
        if: {% raw %}${{ steps.results.outputs.found == 'true' }}{% endraw %}
        uses: quokkify/project-toolkit/actions/allure-report@{{ toolkit_version }}
        with:
          github-token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          results-directory: artifacts/allure-results
          report-directory: allure-report
          config-file: .github/allure/allurerc.mjs
          pr-number: {% raw %}${{ github.event.workflow_run.pull_requests[0].number }}{% endraw %}
          fork-pr: {% raw %}${{ github.event.workflow_run.head_repository.full_name != github.repository }}{% endraw %}
          source-run-id: {% raw %}${{ github.event.workflow_run.id }}{% endraw %}
{% if allure_publish_pages %}
          publish-pages: true
          pages-url: https://{% raw %}${{ github.repository_owner }}{% endraw %}.github.io/{% raw %}${{ github.event.repository.name }}{% endraw %}/allure/pr-{% raw %}${{ github.event.workflow_run.pull_requests[0].number }}{% endraw %}/
          pages-destination-directory: allure/pr-{% raw %}${{ github.event.workflow_run.pull_requests[0].number }}{% endraw %}
{% endif %}
      - name: Upload Allure HTML report
        if: {% raw %}${{ steps.results.outputs.found == 'true' }}{% endraw %}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: allure-report-{% raw %}${{ github.event.workflow_run.id }}{% endraw %}
          path: allure-report
          if-no-files-found: error
          retention-days: 14
