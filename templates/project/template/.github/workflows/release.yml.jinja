name: Release Please

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

concurrency:
  group: release-please-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: false

jobs:
  release:
    uses: quokkify/project-toolkit/.github/workflows/release-please.yml@{{ toolkit_version }}
    with:
      mode: {{ release_mode }}
{%- if release_mode == 'manifest' %}
      config-file: .github/release-please/config.json
      manifest-file: .github/release-please/manifest.json
{%- endif %}
